# Variáveis de ambiente do Akuris — modelo.
#
# Copie para `.env` (ou `.env.local` para overrides que não se versionam) e
# preencha. Só há aqui variáveis `VITE_*`: o Vite injeta-as no bundle do
# cliente, por isso são PÚBLICAS por natureza — a chave publishable é protegida
# por RLS, não é um segredo.
#
# ⚠️  Segredos de verdade NUNCA entram aqui nem em `.env`:
#     · a service_role do Supabase (ignora o RLS — é a chave-mestra do backend)
#     · tokens de integração, chaves de conta de serviço
#     Esses vivem nos secrets das Edge Functions (painel do Supabase) e, em
#     desenvolvimento, em `.env.local`, que o .gitignore e o gitleaks protegem.

# Referência pública do projeto Supabase.
VITE_SUPABASE_PROJECT_ID="o-ref-do-seu-projeto"

# URL pública da API do Supabase.
VITE_SUPABASE_URL="https://o-ref-do-seu-projeto.supabase.co"

# Chave publishable (anon). Pública por desenho — protegida por RLS.
VITE_SUPABASE_PUBLISHABLE_KEY="a-sua-chave-anon"
